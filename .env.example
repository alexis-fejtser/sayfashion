# Адрес магазина без завершающего слеша
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Только для сервера: домен без https:// и пароль внутренней PostgreSQL
DOMAIN=shop.example.by
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Для внешней PostgreSQL вместо PG-переменных можно использовать DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=false

# Админка: /admin
ADMIN_PASSWORD=change-me-now
AUTH_SECRET=replace-with-a-long-random-string

# OpenRouter: генерация описания и рекламного изображения
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# bePaid (оставьте пустыми для локального демо-заказа)
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
# RSA public key магазина из кабинета bePaid (одной строкой или PEM с \n)
BEPAID_PUBLIC_KEY=
BEPAID_TEST=true

# Публичный API отделений Европочты. Обычно менять не нужно.
EUROPOST_API_URL=https://evropochta.by/rest/Json
EUROPOST_SERVICE_NUMBER=E811AE79-DFDE-4F85-8715-DD3A8308707E
EUROPOST_DELIVERY_PRICE=7.90
